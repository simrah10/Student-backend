# ==========================================
# Student Productivity Backend - Environment Template
# Copy this file to .env and fill in your actual values
# ==========================================

# Server Port (Render sets this automatically in production)
PORT=5000

# Environment Mode: development | production | test
NODE_ENV=development

# MongoDB Connection String (MongoDB Atlas or Local MongoDB)
# Example for Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/student-productivity?retryWrites=true&w=majority
# Example for Local: mongodb://127.0.0.1:27017/student-productivity
MONGO_URI=mongodb://127.0.0.1:27017/student-productivity

# Frontend Application Origin (CORS whitelist)
# Set to '*' to allow all origins, or set your frontend domain (e.g. https://my-frontend.onrender.com)
CLIENT_URL=*

# Custom API Keys
API_KEY=your_api_key_here

# Authentication Configuration
JWT_SECRET=your_jwt_secret_key_change_in_production

# Resend Email Service for Password Resets
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here

# Sender Email Address: Use 'StudentFlow <onboarding@resend.dev>' for free testing, or your verified domain
RESEND_FROM_EMAIL=StudentFlow <onboarding@resend.dev>

# Frontend URL used to construct the password reset link (e.g. https://studentflow.onrender.com or http://localhost:5000)
FRONTEND_URL=http://localhost:5000
