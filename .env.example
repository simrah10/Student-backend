# ==========================================
# Student Productivity Backend - Environment Template
# Copy this file to .env and fill in your actual values
# ==========================================

# Server Port (Render sets this automatically in production)
PORT=5000

# Environment Mode: development | production | test
NODE_ENV=development

# MongoDB Connection String (MongoDB Atlas or Local MongoDB)
# Example for Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/student-productivity?retryWrites=true&w=majority
# Example for Local: mongodb://127.0.0.1:27017/student-productivity
MONGO_URI=mongodb://127.0.0.1:27017/student-productivity

# Frontend Application Origin (CORS whitelist)
# Set to '*' to allow all origins, or set your frontend domain (e.g. https://my-frontend.onrender.com)
CLIENT_URL=*

# Custom API Keys
API_KEY=your_api_key_here
